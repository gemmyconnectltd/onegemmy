# REPLACES /etc/nginx/sites-enabled/onegemmy-frontend (same file, only the two proxy_pass ports change):
#   pesaa.io      3000 -> 3004   (the new website container)
#   app.pesaa.io  3001 -> 3000   (the ERP: the existing frontend container; the mobile app on 3001 is no longer routed)
# Back up first:  sudo cp /etc/nginx/sites-enabled/onegemmy-frontend ~/onegemmy-frontend.nginx.bak
# Apply:          sudo nginx -t && sudo systemctl reload nginx
server {
    listen 80;
    server_name pesaa.io www.pesaa.io;

    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name app.pesaa.io;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pesaa.io www.pesaa.io;

    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/pesaa.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pesaa.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl;
    server_name app.pesaa.io;

    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/pesaa.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pesaa.io/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
