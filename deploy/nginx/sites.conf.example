# EXAMPLE ONLY — nothing here is applied automatically. Adapt to how your existing sites are laid out
# (usually one file per site in /etc/nginx/sites-available, linked into sites-enabled), then:
#   sudo nginx -t && sudo systemctl reload nginx
# Certificates: sudo certbot --nginx -d pesaa.io -d www.pesaa.io -d app.pesaa.io -d admin.pesaa.io
# Staging follows the same pattern: staging.pesaa.io -> 3012, staging-app.pesaa.io -> <frontend staging port>,
# staging-admin.pesaa.io -> 3013.
#
# Ports: website 3002 | admin 3003 | app = the port your existing frontend container already publishes
#        (it is the one pesaa.io proxies to TODAY: run `grep -R "proxy_pass" /etc/nginx/sites-enabled` to find it).

# ── pesaa.io: the public website ──────────────────────────────────────────────
server {
    listen 80;
    server_name pesaa.io www.pesaa.io;
    # certbot adds the 443 block and the http->https redirect; the www -> apex redirect lives in the 443 block:
    #   if ($host = www.pesaa.io) { return 301 https://pesaa.io$request_uri; }
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── app.pesaa.io: the customer ERP / POS (existing frontend container) ───────────────
server {
    listen 80;
    server_name app.pesaa.io;
    location / {
        proxy_pass http://127.0.0.1:<FRONTEND_PORT>;   # <- the port pesaa.io points at today
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── admin.pesaa.io: Super Admin (restrict access!) ────────────────────────────────
server {
    listen 80;
    server_name admin.pesaa.io;

    # Strongly recommended: only your own addresses can even load the login page.
    # allow 203.0.113.10;   # office / home IP
    # deny all;
    # ...or a password in front of it:  auth_basic "Admin"; auth_basic_user_file /etc/nginx/.htpasswd-admin;

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
