# REPLACES /etc/nginx/sites-enabled/pesaa-staging. staging.pesaa.io becomes the staging WEBSITE (port 3014);
# the staging ERP (port 3002, today's staging.pesaa.io) moves to staging-app.pesaa.io, the staging admin to staging-admin.pesaa.io.
# Back up first:  sudo cp /etc/nginx/sites-enabled/pesaa-staging ~/pesaa-staging.nginx.bak
# DNS first (A records): staging-app and staging-admin. Then certificates for the two new names:
#   sudo certbot --nginx -d staging-app.pesaa.io -d staging-admin.pesaa.io
# (certbot edits the two HTTP-only blocks below and adds the 443 parts.)
server {
    server_name staging.pesaa.io;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3014;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/staging.pesaa.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/staging.pesaa.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = staging.pesaa.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name staging.pesaa.io;
    return 404; # managed by Certbot
}

# ── staging ERP (the existing staging frontend container on 3002) ──────────────────────
server {
    listen 80;
    server_name staging-app.pesaa.io;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# ── staging admin ───────────────────────────────────────────────────────────────────────
server {
    listen 80;
    server_name staging-admin.pesaa.io;

    location / {
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
