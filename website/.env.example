# Public marketing website (pesaa.io). Build-time values: each environment needs its own build.

# This site's own public URL (canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=https://pesaa.io

# The customer app. "Sign In" / "Get Started" and old /login, /register links go here.
NEXT_PUBLIC_APP_URL=https://app.pesaa.io

# Backend API: contact form and public platform statistics (unauthenticated endpoints only)
NEXT_PUBLIC_API_URL=https://api.pesaa.io/api/v1
