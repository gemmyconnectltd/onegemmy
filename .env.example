# Pesaa Super Admin (admin.pesaa.io). Build-time values: each environment needs its own build.

# Backend API (the same API the customer app uses; every /admin/* endpoint is enforced server-side)
NEXT_PUBLIC_API_URL=https://api.pesaa.io/api/v1

# The customer app (only used for the "looking for your business account?" link on the sign-in page)
NEXT_PUBLIC_APP_URL=https://app.pesaa.io
