ENVIRONMENT=local
DEBUG=true

# Postgres — local
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/onegemmy

# Postgres — production (Neon / Render / Supabase etc.)
DATABASE_NEON_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins
# Production: include the live frontend domain, e.g. https://pesaa.io
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (used in email links)
# Production: https://pesaa.io
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
# Local/staging: any mailbox works; production MUST send from your own domain
# (e.g. no-reply@pesaa.io) or deliverability drops and mail lands in spam.
# Gmail: use an App Password — https://myaccount.google.com/apppasswords
# (For a workspace/domain inbox the app password is generated the same way.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@yourdomain.com>
SMTP_PASSWORD=<your-app-password>
EMAIL_FROM=Pesaa <<your-email@yourdomain.com>>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=
LOG_FORMAT=console

# Seed passwords (used by scripts/seed.py only)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
