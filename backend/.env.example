ENVIRONMENT=local
DEBUG=true

# Postgres
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/onegemmy

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# Email (Gmail SMTP)
# Use a Gmail App Password — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASSWORD=<your-gmail-app-password>
EMAIL_FROM=OneGemmy <<your-gmail@gmail.com>>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=
LOG_FORMAT=console

# Seed passwords (used by scripts/seed.py only)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
