ENVIRONMENT=production
DEBUG=false

# Postgres — installed natively on this VPS (not in Docker), listening on
# localhost.
DATABASE_URL=postgresql+asyncpg://user_gemmy_db:<password>@localhost:5432/onegemmy_prod

# JWT — generate with: openssl rand -hex 32 (use a DIFFERENT secret than staging)
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins (the live frontend domain only, never "*")
CORS_ORIGINS=https://app.gemmyconnect.com

# Frontend URL (used in email links)
FRONTEND_URL=https://app.gemmyconnect.com

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASSWORD=<your-gmail-app-password>
EMAIL_FROM=OneGemmy <<your-gmail@gmail.com>>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=json

# Seed passwords (used by scripts/seed.py only — do not use weak/default values)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
