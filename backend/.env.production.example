ENVIRONMENT=production
DEBUG=false

# Postgres — installed natively on this VPS (not in Docker), listening on
# localhost.
DATABASE_URL=postgresql+asyncpg://user_gemmy_db:<password>@localhost:5432/onegemmy_prod

# JWT — generate with: openssl rand -hex 32 (use a DIFFERENT secret than staging)
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins (never a bare "*"). Use
# "https://*.pesaa.io" to allow every subdomain of an owned domain instead
# of listing each one (app., mobile., etc.) individually.
CORS_ORIGINS=https://pesaa.io,https://*.pesaa.io

# Frontend URL (used in email links)
FRONTEND_URL=https://pesaa.io

# Email — send from your own domain (no-reply@pesaa.io), never a free Gmail
# inbox; free-account senders get flagged to spam. Two options:
#
#   A) Google Workspace on pesaa.io (recommended if you already use Google Workspace):
#      SMTP_HOST=smtp.gmail.com, SMTP_USER=no-reply@pesaa.io, plus a Workspace
#      App Password. DNS on pesaa.io:
#        SPF:   v=spf1 include:_spf.google.com ~all
#        DKIM:  key published by Workspace (Admin > Apps > Google Workspace > Gmail > Authenticate email)
#        DMARC: v=DMARC1; p=quarantine; rua=mailto:dmarc@pesaa.io
#
#   B) AWS SES (SMTP) — cheapest at volume; you'll get SES SMTP creds after setup:
#      SMTP_HOST=email-smtp.eu-west-1.amazonaws.com (match your region)
#      DNS on pesaa.io: SPF include:amazonses.com, DKIM (3 CNAMEs), DMARC as above.
#
# The app only needs SMTP credentials — authentication is Gmail/SES SMTP server-side,
# so the delivered message carries paid-domain SPF/DKIM and stops landing in spam.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<no-reply@pesaa.io>
SMTP_PASSWORD=<app-password-or-ses-smtp-password>
EMAIL_FROM=Pesaa <no-reply@pesaa.io>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=json

# Seed passwords (used by scripts/seed.py only — do not use weak/default values)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
