ENVIRONMENT=production
DEBUG=false

# Postgres — installed natively on this VPS (not in Docker), listening on
# localhost.
DATABASE_URL=postgresql+asyncpg://user_gemmy_db:<password>@localhost:5432/onegemmy_prod

# JWT — generate with: openssl rand -hex 32 (use a DIFFERENT secret than staging)
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins (never a bare "*"). Use
# "https://*.pesaa.io" to allow every subdomain of an owned domain instead
# of listing each one (app., mobile., etc.) individually.
CORS_ORIGINS=https://pesaa.io,https://*.pesaa.io

# Frontend URL (used in email links)
FRONTEND_URL=https://pesaa.io

# Email — cPanel SMTP (premium364-1.web-hosting.com), two separate mailboxes:
#   accounts@pesaa.io — account-lifecycle mail (welcome, verification,
#     password reset, invites, and any other automated account mail)
#   admin@pesaa.io     — tenant-approval/admin-review mail (new signup
#     pending review, approval/rejection notices)
# See app/core/email.py's `sender` param ("accounts" default, "admin" for
# approval workflows) and _resolve_smtp_credentials for how these resolve.
# SMTP_USER/SMTP_PASSWORD/EMAIL_FROM below are the fallback used if
# ACCOUNTS_*/ADMIN_* are ever left unset — keep them pointed at
# accounts@pesaa.io too so that fallback never surprises you.
SMTP_HOST=premium364-1.web-hosting.com
SMTP_PORT=587
SMTP_USER=accounts@pesaa.io
SMTP_PASSWORD=<accounts@pesaa.io mailbox password>
EMAIL_FROM=Pesaa Accounts <accounts@pesaa.io>

ACCOUNTS_SMTP_USER=accounts@pesaa.io
ACCOUNTS_SMTP_PASSWORD=<accounts@pesaa.io mailbox password>
ACCOUNTS_EMAIL_FROM=Pesaa Accounts <accounts@pesaa.io>

ADMIN_SMTP_USER=admin@pesaa.io
ADMIN_SMTP_PASSWORD=<admin@pesaa.io mailbox password>
ADMIN_EMAIL_FROM=Pesaa Admin <admin@pesaa.io>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=json

# Seed passwords (used by scripts/seed.py only — do not use weak/default values)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
