ENVIRONMENT=production
DEBUG=false

# Postgres — installed natively on this VPS (not in Docker), listening on
# localhost.
DATABASE_URL=postgresql+asyncpg://user_gemmy_db:<password>@localhost:5432/onegemmy_prod

# JWT — generate with: openssl rand -hex 32 (use a DIFFERENT secret than staging)
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins (never a bare "*"). Use
# "https://*.pesaa.io" to allow every subdomain of an owned domain instead
# of listing each one (app., mobile., etc.) individually.
CORS_ORIGINS=https://pesaa.io,https://*.pesaa.io

# Frontend URL (used in email links)
FRONTEND_URL=https://pesaa.io

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASSWORD=<your-gmail-app-password>
EMAIL_FROM=Pesaa <<your-gmail@gmail.com>>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=json

# Seed passwords (used by scripts/seed.py only — do not use weak/default values)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
