ENVIRONMENT=staging
DEBUG=false

# Only needed if staging and production share one VPS: since the container
# uses network_mode: host, they can't both bind port 8000. Give staging a
# distinct port (e.g. 8001) and point your reverse proxy at it.
PORT=8001

# Postgres — installed natively on this VPS (not in Docker), listening on
# localhost. Use a separate database from production, never the same one.
DATABASE_URL=postgresql+asyncpg://user_gemmy_db:<password>@localhost:5432/onegemmy_test

# JWT — generate with: openssl rand -hex 32 (use a DIFFERENT secret than production)
SECRET_KEY=<your-64-char-random-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS — comma separated list of allowed origins (the staging frontend only)
CORS_ORIGINS=https://staging.gemmyconnect.com

# Frontend URL (used in email links)
FRONTEND_URL=https://staging.gemmyconnect.com

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASSWORD=<your-gmail-app-password>
EMAIL_FROM=OneGemmy Staging <<your-gmail@gmail.com>>

# File uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_FORMAT=json

# Seed passwords (used by scripts/seed.py only — don't reuse production values)
SEED_ADMIN_PASSWORD=<seed-admin-password>
SEED_USER_PASSWORD=<seed-user-password>
SEED_SUPER_ADMIN_PASSWORD=<seed-superadmin-password>
