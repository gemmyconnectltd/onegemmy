# Backend API URL
# Production: https://onegemmy.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# App URL
# Production: https://app.gemmyconnect.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# App name
NEXT_PUBLIC_APP_NAME=OneGemmy

# Extra mobile-app subdomains/domains (comma separated), beyond the built-in
# shop./m./mobile. prefixes — see src/lib/mobileHost.ts
MOBILE_APP_HOSTS=
