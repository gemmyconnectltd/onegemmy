# Backend API URL
# Production: set this to your VPS-hosted API's URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# This app's own URL
# Production: https://app.pesaa.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The public website (terms/privacy links) and the Super Admin portal (platform admins who sign in here are pointed to it)
# Production: https://pesaa.io and https://admin.pesaa.io
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# App name
NEXT_PUBLIC_APP_NAME=Pesaa

# Extra mobile-app subdomains/domains (comma separated), beyond the built-in
# shop./m./mobile. prefixes — see src/lib/mobileHost.ts
MOBILE_APP_HOSTS=

# The mobile app's own deployment URL (the root mobile/ project — a separate
# codebase and deployment, not a route inside this app).
# Production: set to wherever mobile/ is deployed, e.g. https://shop.pesaa.io
MOBILE_APP_URL=
